rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Published catalogue is queryable via published == true; only administrators publish.
    match /mock_catalog/{mockId} {
      allow read: if request.auth != null && resource.data.published == true;
      allow write: if false;
    }
    // Firebase administrator-only access switch. A missing doc means rewarded mode.
    match /app_config/{configId} {
      allow get: if request.auth != null && configId == 'monetization';
      allow list, write: if false;
    }
    function premiumModeEnabled() {
      return exists(/databases/$(database)/documents/app_config/monetization) &&
        get(/databases/$(database)/documents/app_config/monetization).data.premiumEnabled == true;
    }
    // Every paper is a document with questionsJson string (up to Firestore 1 MiB limit).
    // Anonymous authentication is silent; no signup page is required.
    // IMPORTANT: this protects against public anonymous requests, NOT against answer scraping.
    // For verified contests use Cloud Functions with private answer keys.
    // Mocks 50–100 are remotely switchable; when premiumEnabled=true, block
    // their papers until server-verified purchases and entitlements are built.
    // Rewarded ad unlocks remain UI-only until ad SSV is implemented.
    match /mock_papers/{mockId} {
      allow get: if request.auth != null &&
        get(/databases/$(database)/documents/mock_catalog/$(mockId)).data.published == true &&
        get(/databases/$(database)/documents/mock_catalog/$(mockId)).data.testId is int &&
        get(/databases/$(database)/documents/mock_catalog/$(mockId)).data.testId >= 1 &&
        get(/databases/$(database)/documents/mock_catalog/$(mockId)).data.testId <= 100 &&
        (get(/databases/$(database)/documents/mock_catalog/$(mockId)).data.testId < 50 ||
         !premiumModeEnabled());
      allow list, write: if false;
    }
    // Firebase Console / Admin SDK controls what the app shows; no client writes.
    match /promo_banners/{bannerId} {
      allow get, list: if request.auth != null && resource.data.active == true;
      allow write: if false;
    }
    match /exam_events/{eventId} {
      allow get, list: if request.auth != null && resource.data.published == true;
      allow write: if false;
    }
    // Prototype leaderboard: client-submitted results are NOT anti-cheat verified.
    match /{collection}/{userId} {
      allow read: if request.auth != null && collection.matches('leaderboard_mock_([1-9]|[1-9][0-9]|100)');
      allow create, update: if request.auth != null &&
        collection.matches('leaderboard_mock_([1-9]|[1-9][0-9]|100)') &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['uid','name','score','correct','submittedAt']) &&
        request.resource.data.uid == userId &&
        request.resource.data.name is string && request.resource.data.name.size() <= 28 &&
        request.resource.data.score is int &&
        request.resource.data.score >= -150 && request.resource.data.score <= 600 &&
        request.resource.data.correct is int &&
        request.resource.data.correct >= 0 && request.resource.data.correct <= 150 &&
        request.resource.data.submittedAt is int &&
        (!exists(/databases/$(database)/documents/$(collection)/$(userId)) ||
        request.resource.data.score >= resource.data.score);
      allow delete: if request.auth != null && request.auth.uid == userId &&
        collection.matches('leaderboard_mock_([1-9]|[1-9][0-9]|100)');
    }
  }
}
